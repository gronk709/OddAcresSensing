# Supabase project settings -> Data API / API keys.
# Newer projects label the anon key "publishable key"; either works here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Which station the dashboard shows.
NEXT_PUBLIC_DEVICE_ID=snodek104

# Display timezone for day boundaries and axis labels.
NEXT_PUBLIC_TIMEZONE=Australia/Sydney
